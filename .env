# Clé auth interne HuggingFace → Render
RTM_GK=rtm_secret_default_key_123

# Clé API TMDB (metadata films/séries)
RTM_MK=973515c7684f56d1472bba67b13d676b

# Base URL TMDB API
RTM_MB=https://api.themoviedb.org/3

# Serveur embed principal
RTM_SE=https://multiembed.mov

# Serveur de téléchargement direct
RTM_SD=https://dl.multiembed.mov

# CDN images TMDB
RTM_SI=https://image.themoviedb.org

# Code VIP (hashé en sha256 dans le code)
RTM_VP=121206

# Sources IPTV (séparées par virgule)
RTM_TV=https://iptv-org.github.io/iptv/index.m3u,https://iptv-org.github.io/iptv/countries/mg.m3u,https://iptv-org.github.io/iptv/countries/re.m3u,https://iptv-org.github.io/iptv/countries/mu.m3u

# Port
PORT=3000
